{
  "title": "Caps Lock to Hyper Key (Command-Control-Option-Shift)",
  "rules": [
    {
      "description": "Hyper Key: map Caps Lock to Shift-Command-Control-Option",
      "manipulators": [
        {
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": ["left_command", "left_control", "left_option"]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
