# Local Filesystem Searches
###########################

# determine if we are in a node_modules folder or if a valid node_modules path was passed via any argument
function _is_node_modules() {
  local node_modules_path=$1

  if [[ -z "$node_modules_path" ]]; then
    node_modules_path=$(pwd)
  fi

  [[ "$node_modules_path" =~ node_modules$ ]]
}

function _is_venv() {
  local venv_path=$1

  if [[ -z "$venv_path" ]]; then
    venv_path=$(pwd)
  fi

  [[ "$venv_path" =~ \.venv$ ]]
}

alias ff="fzf --preview='bat --color=always {}'"

# fd + fzf, unrestricted (like rgu)
fdu() {
  fd --no-ignore-vcs --hidden \
    --exclude .git --exclude .venv --exclude .pnpm --exclude node_modules --exclude .tox --exclude cdk.out \
    "$@" |
    fzf --keep-right --preview 'if [ -d {} ]; then eza -1 --color=always {}; elif [ -f {} ]; then bat --color=always {}; fi'
}

# TODO this should use the `cd` alt+c thing and just overload there instead
# fd + fzf, cd into the selected directory
fdd() {
  local additional_args=""

  if _is_node_modules "$@" || _is_venv "$@"; then
    additional_args="--no-ignore-vcs --hidden"
  fi

  local file_or_directory=$(fd ${=additional_args} "$@" | fzf --preview 'if [ -d {} ]; then eza -1 --color=always {}; elif [ -f {} ]; then cat {}; fi')

  # cd into dir or view the file
  if [[ -n "$file_or_directory" ]]; then
    if [[ -d "$file_or_directory" ]]; then
      cd "$file_or_directory"
    elif [[ -f "$file_or_directory" ]]; then
      cat "$file_or_directory"
    fi
  fi
}

RIPGREP_LIVEGREP_EXCLUSIONS=("--glob=!.git/**" "--glob=!.venv" "--glob=!.pnpm" "--glob=!node_modules" "--glob=!.tox" "--glob=!cdk.out")

# TODO add fzf support
# search all files in the current directory
rgu() {
  # TODO use glob list from find-replace
  rg -uu "${RIPGREP_LIVEGREP_EXCLUSIONS[@]}" "$@"
}

# livegrep-like local search
# related: https://github.com/seletskiy/zsh-fuzzy-search-and-edit/blob/master/plugin.zsh
rgg() {
  local additional_args=""

  # TODO should check search page in $@ as well
  if [[ $(pwd) =~ node_modules$ ]] || [[ $(pwd) == *"/.venv/"* ]]; then
    # in this case, we want to search the contents of the node_modules directory
    # this is a common case for me, trying to debug various package bugs in a project I'm working on
    additional_args="--no-ignore-vcs --hidden"
  fi

  # TODO --bind=\"ctrl-y:execute-silent(echo {} | cut -d: -f1 | tr -d '[:space:]' | pbcopy)\" \
  local file_and_location=$(rg --color always --hidden "$@" ${=additional_args} | fzf --ansi --delimiter : --with-nth '1,4' --preview 'height=$(tput lines); start={2}; context=$((height / 2)); bat --color=always --paging=never --highlight-line {2} --line-range $((start > context ? start - context : 1)):$((start + context)) {1}')

  # Extracting the file name from the selected line
  local file=$(echo "$file_and_location" | awk -F: '{print $1}')

  if [[ ! -z "$file" ]]; then
    open "$file"
  fi
}

# ripgrep file
rgf() {
  rg "$@" --files-with-matches | sort -u
}

# ripgrep "only": only display the matching text in the first capture group
# this is helpful for selecting and transforming
rgo() {
  params=()

  # check if the user is passing in `-r`, if not, then default to a basic option
  if ((${@[(I)*-r*]} == 0)); then
    params+=("-r \$1")
  fi

  rg $@ $params --no-filename --no-column --no-line-number --color never --only-matching
}

# find and replace across files in the current directory
function find-replace() {
  if [ $# -lt 2 ]; then
    echo "Usage: find-replace <find_string> <replace_string>"
    return 1
  fi

  local find_string=$1
  local replace_string=$2
  local files=( $(rg -uu --glob '!.git/**' --glob '!.venv' --glob '!.pnpm' --glob '!node_modules' --glob '!.tox' --glob '!cdk.out' -l --fixed-strings "$find_string") )

  echo "${#files[@]} files found."

  for file in "${files[@]}"; do
    # sd is modern replacement for sed
    sd --preview --fixed-strings "$find_string" "$replace_string" "$file"

    read "confirmation?Confirm replace in '$file'. [y/n]:"

    if [[ $confirmation =~ ^[Yy]$ ]]; then
      sd --fixed-strings "$find_string" "$replace_string" "$file"
    fi
  done
}

###########################
# File opening functions
###########################

parse_file_path() {
  # Supported inputs (paths may be relative, absolute, or contain spaces):
  #   src/my file.py                     plain path
  #   src/file.py:25                      line
  #   src/file.py:25:40                   line and column
  #   src/file.py:25:40: diagnostic text  grep/compiler output (also :25: text)
  #   src/file.py:26-75                   line range
  #   src/file.py(42) / src/file.py(42,10) compiler-style position
  #   src/file.py#L46 / src/file.py#46    fragment line
  #   src/file.py#L46-L67 / src/file.py#46-67  fragment range
  #   file:///tmp/my%20file.py:25:40      file URI with percent decoding
  #   M  src/file.py / ?? src/file.py     Git status prefix
  # Outer whitespace and nested matching "", '', ``, (), [], <>, {} are removed,
  # as are a single unmatched quote at either end and trailing :, comma, or ;.
  # Multiple leading slashes collapse to one. Ranges select their first line.
  # Sets PARSED_FILE, PARSED_LINE, PARSED_COL; missing line/column stay empty.
  emulate -LR zsh
  setopt extended_glob
  local input="$1"
  local MATCH MBEGIN MEND
  local -a match mbegin mend

  # Trim whitespace and unwrap nested quotes/brackets/parens.
  while true; do
    input=${${input##[[:space:]]#}%%[[:space:]]#}
    case "${input[1]}${input[-1]}" in
      '""'|"''"|'``'|'()'|'[]'|'<>'|'{}') input=${input[2,-2]} ;;
      *) break ;;
    esac
  done

  # Strip unbalanced quotes and trailing punctuation.
  input="${input#[\"\'\`]}"
  input="${input%[\"\'\`]}"
  input=${input%%[:,;]#}

  # Strip git status prefixes (e.g. "M ", " M ", "?? ", "A ", "D ", "R ")
  if [[ "$input" =~ '^[[:space:]]*[MADRCU?]{1,2}[[:space:]]+(.*)$' ]]; then
    input="${match[1]}"
  fi

  # Handle file:// scheme
  if [[ "$input" == file://* ]]; then
    input="${input#file://}"
    if [[ "$input" == *%* ]]; then
      input="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "$input" 2>/dev/null || print -r -- "$input")"
    fi
  fi

  # Each pattern captures file, line, separator/range, column (if present).
  local fragment='^([^#]+)#L?([0-9]+)(-L?[0-9]+)?.*' # path#L46-L67
  local parens='^([^(]+)\(([0-9]+)(,([0-9]+))?\)' # path(42,10)
  local colon='^([^:]+):([0-9]+)(:([0-9]+)|-[0-9]+)?(:.*)?$' # path:25:40

  PARSED_FILE="$input" PARSED_LINE="" PARSED_COL=""
  if [[ "$input" =~ $fragment || "$input" =~ $parens || "$input" =~ $colon ]]; then
    PARSED_FILE="${match[1]}" PARSED_LINE="${match[2]}" PARSED_COL="${match[4]}"
  fi

  # Collapse multiple leading slashes (e.g. ///Users -> /Users).
  [[ "$PARSED_FILE" == //* ]] && PARSED_FILE=/${PARSED_FILE##/##}
  return 0
}

open_in_nvim() {
  [[ -z "$1" ]] && return 0
  local PARSED_FILE PARSED_LINE PARSED_COL
  parse_file_path "$1"
  local -a args
  if [[ -n "$PARSED_LINE" && -n "$PARSED_COL" ]]; then
    args+=("+call cursor($PARSED_LINE, $PARSED_COL)")
  elif [[ -n "$PARSED_LINE" ]]; then
    args+=("+$PARSED_LINE")
  fi
  nvim "${args[@]}" -- "$PARSED_FILE" < /dev/tty
}

open_in_cursor() {
  [[ -z "$1" ]] && return 0
  local PARSED_FILE PARSED_LINE PARSED_COL
  parse_file_path "$1"
  local -a args
  if [[ -n "$PARSED_LINE" ]]; then
    args+=(--goto)
  fi
  cursor "${args[@]}" -- "$PARSED_FILE${PARSED_LINE:+:$PARSED_LINE}${PARSED_COL:+:$PARSED_COL}"
}

open_in_cat() {
  [[ -z "$1" ]] && return 0
  local PARSED_FILE PARSED_LINE PARSED_COL
  parse_file_path "$1"
  local line="${PARSED_LINE:-1}"
  local context=$(($(tput lines) / 2))

  bat --color=always --highlight-line "$line" \
    --line-range $((line > context ? line - context : 1)):$((line + context)) -- "$PARSED_FILE"
}
