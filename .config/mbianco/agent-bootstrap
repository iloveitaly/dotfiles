# Should be loaded very soon in zshrc
# Set AGENT_DEBUG=1 to enable debug mode

# Returns 0 (true) when running under an AI-agent managed terminal.
# https://github.com/sdairs/is-ai-agent use this as a reference
ai_is_agent_terminal() {
  # TERM=dumb is a fallback for agents that don't set a dedicated env var.
  [[ -n "${AI_AGENT:-}" || -n "${AGENT:-}" || -n "${VSCODE_AGENT:-}" || -n "${CURSOR_AGENT:-}" || -n "${CLAUDECODE:-}" || -n "${GEMINI_CLI:-}" || -n "${ANTIGRAVITY_AGENT:-}" || -n "${GROK_SESSION_ID:-}" || -n "${CODEX_CI:-}" || "${TERM:-}" == "dumb" ]]
}

# test with:
# AGENT_DEBUG=1 VSCODE_AGENT=1 zsh -lc 'print -r -- "$PWD"'
#
# Called by ai_load_agent_configuration during non-interactive agent startup.
ai_refresh_agent_environment() {
  # Environment configuration can launch another zsh. Suppress recursive refreshes
  # only while these generators run; ordinary child shells must refresh for $PWD.
  [[ -n "${_AI_AGENT_ENV_REFRESHING:-}" ]] && return 0

  # Export this function-local flag to child processes, then restore it on return.
  local -x _AI_AGENT_ENV_REFRESHING=1

  # mise supplies tools (including direnv); .envrc overrides are applied last.
  # Keep overlapping variables in one system: both track values for unloading.
  eval "$(command mise hook-env -s zsh)"

  if (( $+commands[direnv] )); then
    eval "$(command direnv export zsh)"
  else
    print -u2 -- 'Warning: direnv is not installed; skipping .envrc loading.'
  fi
}

ai_load_agent_configuration() {
  # .zshenv and .zshrc call this only after ai_is_agent_terminal succeeds.
  # Non-interactive shells have no prompt hooks. Refresh for their starting
  # directory even when general agent settings were inherited from a parent.
  # 
  # This runs once at startup. A later cd in this shell does not refresh the env.
  # This is helpful to autoload mise + direnv configuration for the directory an agent is operating under.
  if [[ ! -o interactive ]]; then
    ai_refresh_agent_environment
  fi

  # General agent settings can be inherited; directory environments cannot.
  if [[ -n "${AGENT_CONFIGURED:-}" ]]; then
    [[ ${AGENT_DEBUG:-} -eq 1 ]] && echo "Agent already configured, skipping"
    return 0
  fi

  # Warn if shell nesting is excessive
  local shlvl="${SHLVL:-0}"
  if [[ "$shlvl" -gt 5 ]]; then
    echo -e "\033[33mWarning: Excessive shell nesting detected (SHLVL=$shlvl)\033[0m"
  fi

  # Debug: Log if shell level is greater than 1
  if [[ "$shlvl" -gt 1 && ${AGENT_DEBUG:-} -eq 1 ]]; then
    echo -e "\033[36mDebug: Shell nesting level is $shlvl\033[0m"
  fi

  if [[ -o interactive ]]; then
    # Interactive shells continue refreshing through their usual hooks.
    source <(mise activate)
    if (( $+commands[direnv] )); then
      source <(direnv hook zsh)
    else
      print -u2 -- 'Warning: direnv is not installed; skipping .envrc loading.'
    fi
  fi

  [[ ${AGENT_DEBUG:-} -eq 1 ]] && echo "In agent shell, sourced configuration"

  export GIT_EDITOR=true
  export PAGER=cat
  export GIT_PAGER=$PAGER
  export GH_PAGER=$PAGER
  export MANPAGER=$PAGER

  # for our own internal debugging
  export AGENT_CONFIGURED=1

  return 0
}
