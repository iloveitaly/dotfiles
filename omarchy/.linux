# Linux / Omarchy shell overrides (sourced from ~/.zshrc when present).
# Shared .exports defaults EDITOR=micro (macOS); use nvim on this host.

export EDITOR=nvim

# 1Password SSH agent for git / CLIs that ignore ssh_config IdentityAgent.
# The sock is always expected on this host; do not override a forwarded agent.
if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
  export SSH_AUTH_SOCK="${HOME}/.1password/agent.sock"
fi
if [[ ! -S "${HOME}/.1password/agent.sock" ]]; then
  print -u2 -- "warning: expected 1Password SSH agent socket at ${HOME}/.1password/agent.sock"
fi

# macOS command shims for Wayland
alias pbcopy='wl-copy'
alias pbpaste='wl-paste'

# shared .aliases points tailscale at the macOS app binary
unalias tailscale 2>/dev/null

# forgit is a bash script, so zsh pbcopy aliases do not apply
export FORGIT_COPY_CMD='wl-copy'

# macOS `open`: return immediately, no shell job-control entries (no jobs/fg).
# Bare `xdg-open &` leaves a stoppable job; setsid+disown matches macOS.
open() {
  local f
  for f in "$@"; do
    setsid xdg-open "$f" </dev/null >/dev/null 2>&1 &!
  done
}
