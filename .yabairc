#!/usr/bin/env sh
# yabai config — space labels + float layout (not a tiling setup)
# https://github.com/koekeishiya/yabai/wiki

# Scripting addition (spaces create/destroy, some focus features).
# Requires partial SIP disable + sudoers; leave commented until configured.
# https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
# yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
# sudo yabai --load-sa

# Keep normal macOS window placement; only use yabai for space labels / moves.
yabai -m config layout float

# Named spaces (Mission Control indices are 1-based).
# Space 1 left unlabeled as the default desktop.
yabai -m space 1 --label personal
yabai -m space 2 --label communications
yabai -m space 3 --label ai-dev
yabai -m space 4 --label railpack
yabai -m space 5 --label militia-media
yabai -m space 6 --label open-source
yabai -m space 7 --label protege

# Pull these apps onto the Space we were working on when they gain focus
# (Spotlight / Raycast / Cmd-Tab), instead of switching to their old Space.
# `window --space mouse` is not enough: macOS still swooshes to the old Space
# after the move, and `mouse` can land on the other display.
# pull_to_active_space="${HOME}/.config/yabai/pull-to-active-space.sh"
# yabai -m signal --add event=window_focused app="^1Password$" label="pull-1password" action="$pull_to_active_space"
# yabai -m signal --add event=window_focused app="^Todoist$" label="pull-todoist" action="$pull_to_active_space"
# yabai -m signal --add event=window_focused app="^Obsidian$" label="pull-obsidian" action="$pull_to_active_space"

# Update Raycast yabai extension menu bar indicator on space change
yabai -m signal --add event=space_changed \
  label="refresh-raycast-spaces" \
  action="open -g 'raycast://extensions/krzysztoff1/yabai/screens-menu-bar?launchType=background'"

yabai -m rule --add app="^Discord$" space=^railpack

yabai -m rule --add app="^Superwhisper$" manage=off sticky=on
yabai -m rule --add app="^1Password$" manage=off sticky=on
yabai -m rule --add app="^Todoist$" manage=off sticky=on
yabai -m rule --add app="^Obsidian$" manage=off sticky=on
yabai -m rule --add app="^Raycast$" manage=off sticky=on
yabai -m rule --add app="^Tailscale$" manage=off sticky=on
yabai -m rule --add app="^Harvest$" manage=off sticky=on
yabai -m rule --add app="^YT Music$" manage=off sticky=on